[sub_resource type="GDScript" id="GDScript_8fkn4"]
script/source = "@tool
extends Node

func remove_unused_doors():
	for door in $\"..\".get_doors():
		if door.get_room_leads_to() == null:
			door.door_node.queue_free()

func _on_dungeon_done_generating():
	remove_unused_doors()
"

